{
  "name": "@medyat/react-data-table",
  "version": "0.2.0",
  "description": "React 19 için liste tablosu: @medyat/vue-data-table sözleşmesiyle aynı çekirdek.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medyat/react-data-table.git"
  },
  "homepage": "https://github.com/medyat/react-data-table#readme",
  "bugs": {
    "url": "https://github.com/medyat/react-data-table/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs/backend-integration.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./shadcn-bridge.css": "./dist/shadcn-bridge.css",
    "./shadcn-bridge-hsl.css": "./dist/shadcn-bridge-hsl.css"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:docs": "node --experimental-strip-types scripts/tokens-from-docs.ts && node --experimental-strip-types scripts/i18n-from-docs.ts",
    "check": "pnpm typecheck && pnpm lint && prettier --check . && pnpm test && pnpm build",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@base-ui/react": "1.9.0",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.60.0",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/react-query": "5.105.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "write-excel-file": "4.1.1"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "react-day-picker": "10.0.2"
  }
}
